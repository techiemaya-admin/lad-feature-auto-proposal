{
  "name": "new-auto-proposal-backend",
  "version": "1.0.0",
  "description": "Express backend with SQLite persistence for zero-config auto-proposal prototype",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/tests/**/*.test.ts"
  },
  "dependencies": {
    "@firecrawl/anydoc": "^0.2.4",
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.5",
    "docxmlater": "^12.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
