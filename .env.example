# ==============================================
# Application Configuration
# ==============================================
NODE_ENV=development
PORT=3001
# DEBUG=true

# ==============================================
# Database Configuration (PostgreSQL)
# ==============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lad_dev
DB_USER=lad_dev
DB_PASSWORD=

# ==============================================
# Authentication (required)
# ==============================================
# HMAC secret shared with the token issuer, at least 32 characters. The app will not start without it.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# Optional: enforce the token's iss / aud claims
# JWT_ISSUER=
# JWT_AUDIENCE=
# Optional: separate secret for signing Google OAuth state (defaults to a key derived from JWT_SECRET)
# OAUTH_STATE_SECRET=

# Encryption key for Gmail OAuth tokens stored in the database (required in production).
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# After first setting it, run once: node scripts/maintenance/encrypt-existing-tokens.js
TOKEN_ENCRYPTION_KEY=

# Origin of the frontend that opens the Google OAuth popup (required: the authorization code
# is only ever posted to this origin)
FRONTEND_URL=http://localhost:3000
# Browser origins allowed by CORS (comma-separated). Defaults to FRONTEND_URL's origin.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
# Transitional only: link Gmail directly in the OAuth callback (vulnerable to login-CSRF).
# Leave unset once the frontend calls POST /api/social-integration/email/google/complete.
# GOOGLE_OAUTH_LEGACY_CALLBACK=true

# Rate limits (requests per minute per user, or per IP when unauthenticated)
# RATE_LIMIT_PER_MINUTE=300
# AI_RATE_LIMIT_PER_MINUTE=20
# Set when behind a load balancer/proxy so client IPs are used (e.g. 1 or loopback)
# TRUST_PROXY=1

# ==============================================
# Google OAuth 2.0 (Gmail Integration)
# ==============================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://developers.google.com/oauthplayground
GOOGLE_REFRESH_TOKEN=your-google-refresh-token
GOOGLE_PUBSUB_TOPIC=projects/lad-develop/topics/gmail-read-send
# Pub/Sub push authentication (required): the webhook only accepts pushes signed by this service account
# for this audience. Configure the same values on the push subscription.
PUBSUB_PUSH_AUDIENCE=https://your-api.example.com/api/gmail/webhook
PUBSUB_PUSH_SERVICE_ACCOUNT=pubsub-push@your-project.iam.gserviceaccount.com
# Local development only (ignored when NODE_ENV=production): skip push verification
# PUBSUB_SKIP_VERIFY=true

# ==============================================
# Gemini AI Configuration
# ==============================================
# Single API Key or base key for rotation
GEMINI_API_KEY=your-gemini-api-key
# Key rotation flag (default: true)
GEMINI_KEY_ROTATION=true
# Additional keys for rotation (optional):
# GEMINI_API_KEY_1=your-gemini-api-key-1
# GEMINI_API_KEY_2=your-gemini-api-key-2
GEMINI_MODEL=gemini-2.5-flash

# ==============================================
# OpenAI Configuration (Optional / Fallback)
# ==============================================
OPENAI_API_KEY=your-openai-api-key

# ==============================================
# AI Auto-Proposal Content Settings
# ==============================================
YOUR_NAME=YourCompanyName
ALTERNATIVE_CONTACT=+1234567890
MAX_REPLY_LENGTH=500
EMAIL_BODY_LIMIT=2000

# ==============================================
# Google Cloud Storage (GCS) Configuration
# ==============================================
GCS_BUCKET=your-gcs-bucket-name
GCS_KEY_FILE=./service-account.json
# Extra https hosts allowed for logos/template images (comma-separated). storage.googleapis.com is always allowed.
# ALLOWED_IMAGE_HOSTS=

# ==============================================
# LibreOffice (Optional override for docx->pdf conversion)
# ==============================================
# SOFFICE_PATH=/usr/bin/soffice

# ==============================================
# Dev / Testing Configuration (Optional)
# ==============================================
# DEV_TEST_TENANT_ID=<tenant-uuid used by scripts/dev/smoke-test.js>
