NODE_ENV=development
PORT=3000

# PostgreSQL (DB_PASSWORD is required; the app will not start without it)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lad_dev
DB_USER=
DB_PASSWORD=

# Authentication (required). HMAC secret shared with the token issuer, at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# Optional: enforce the token's iss / aud claims
JWT_ISSUER=
JWT_AUDIENCE=
